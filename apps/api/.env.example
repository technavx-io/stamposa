# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Data stores ────────────────────────────────────────────────────────────
# Local PostgreSQL (Homebrew default):
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/loyalty_platform?schema=public
# Docker compose alternative (see docker-compose.yml at repo root):
# DATABASE_URL=postgresql://loyalty:loyalty@localhost:5433/loyalty_platform?schema=public

REDIS_URL=redis://localhost:6379
# Docker compose alternative:
# REDIS_URL=redis://localhost:6380

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32   (use two different values)
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# ── URLs ───────────────────────────────────────────────────────────────────
# Public URL of the Next.js app (used inside QR codes / join links).
WEB_APP_URL=http://localhost:3000
# Public URL of this API (used to build absolute upload URLs).
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ── Files ──────────────────────────────────────────────────────────────────
# Local disk storage for development; swap the storage provider for S3 later.
UPLOAD_DIR=./uploads

# ── SMS / OTP ──────────────────────────────────────────────────────────────
# 'console' prints OTP codes to the API log (development).
# 'msg91' sends real SMS via MSG91's DLT-compliant Flow API — see
# docs/SMS-SETUP.md; all three MSG91_* values are then required.
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=STMPSA
# When true (and NODE_ENV != production) the OTP code is also returned by the
# API response so the web app can show a dev hint. NEVER enable in production.
OTP_DEV_EXPOSE=true
# Default region for phone numbers typed without a country code.
DEFAULT_PHONE_REGION=IN

# ── Transactional email (merchant signup verification) ──────────────────
# console = just log the code (fine for dev/staging; the code also shows
# on-screen via OTP_DEV_EXPOSE). smtp = actually send it.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=smtp. Gmail example: host smtp.gmail.com,
# port 587, secure false, user your@gmail.com, pass a 16-char app-password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From header, e.g. "Stamposa <no-reply@yourdomain.com>".
SMTP_FROM=

# Set false to sign in to /admin with just email + password (development
# convenience). Refused in production — admin accounts reach every tenant.
ADMIN_REQUIRE_2FA=true

# ── Error monitoring (optional) ────────────────────────────────────────────
# Sentry-compatible DSN; empty = monitoring off. See docs/MONITORING-SETUP.md.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Billing: Dodo Payments (Merchant of Record) ────────────────────────────
# Empty DODO_API_KEY = paid checkout disabled (billing screen shows a
# "contact us" CTA). Fill from the Dodo dashboard. See docs/BILLING-SETUP.md.
DODO_ENVIRONMENT=test_mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# One product id per paid tier × interval:
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_GROWTH_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
