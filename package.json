{
  "name": "stamposa",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant SaaS loyalty platform — Phase 1 (merchant portal, staff console, customer cards)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:deploy": "npm run prisma:deploy -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "version:set": "node scripts/set-version.mjs",
    "version:show": "node -p \"require('./package.json').version\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
