{
  "name": "stamposa",
  "version": "0.10.0",
  "private": true,
  "description": "Stamposa — digital loyalty cards. Backend API, the app (portals + customer cards), the marketing website, and the UI package they share.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend,website -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:website\"",
    "dev:backend": "npm run start:dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "dev:website": "npm run dev -w apps/website",
    "build": "npm run build -w apps/backend && npm run build -w apps/frontend && npm run build -w apps/website",
    "lint": "npm run lint -w apps/backend && npm run lint -w apps/frontend && npm run lint -w apps/website",
    "test": "npm run test -w apps/backend",
    "db:migrate": "npm run prisma:migrate -w apps/backend",
    "db:deploy": "npm run prisma:deploy -w apps/backend",
    "db:seed": "npm run prisma:seed -w apps/backend",
    "db:studio": "npm run prisma:studio -w apps/backend",
    "version:set": "node scripts/set-version.mjs",
    "version:show": "node -p \"require('./package.json').version\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
