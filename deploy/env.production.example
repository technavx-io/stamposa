# Production environment — copy to deploy/.env.production and fill in.
#   cp deploy/env.production.example deploy/.env.production
# NEVER commit .env.production.

# ── Domains ────────────────────────────────────────────────────────────────
# Three DNS A records must point at this server BEFORE first deploy
# (Caddy needs them to obtain HTTPS certificates):
#   stamposa.com  ·  www.stamposa.com  ·  api.stamposa.com
# APP_DOMAIN is the bare domain — the marketing site and all portals are
# served from it; www redirects here automatically.
APP_DOMAIN=stamposa.com
API_DOMAIN=api.stamposa.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@stamposa.com

# ── Database ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# ── Auth secrets ───────────────────────────────────────────────────────────
# Generate EACH with: openssl rand -hex 32  (two different values!)
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars

# ── Admin panel ────────────────────────────────────────────────────────────
# Must stay true in production — the API refuses to boot otherwise.
ADMIN_REQUIRE_2FA=true
# Password for the seeded admin accounts (change after first login).
SEED_ADMIN_PASSWORD=replace-me-strong

# ── SMS ────────────────────────────────────────────────────────────────────
# 'console' prints OTPs to `docker compose logs api` — fine for a staging
# server, useless for real customers. For real SMS set msg91 and fill in the
# three credentials (docs/SMS-SETUP.md walks through MSG91 + DLT setup; the
# API refuses to boot with msg91 selected and a credential missing).
SMS_PROVIDER=console
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=STMPSA
DEFAULT_PHONE_REGION=IN

# ── Error monitoring (optional — see docs/MONITORING-SETUP.md) ─────────────
# One Sentry project per app. Leave empty to run without monitoring.
# SENTRY_DSN=
# WEB_SENTRY_DSN=

# ── Wallet passes (optional — see docs/WALLET-SETUP.md) ────────────────────
# Uncomment and point at real credentials to enable each wallet.
# APPLE_WALLET_CERT_PATH=/opt/loyalty-secrets/signer.pem
# APPLE_WALLET_KEY_PATH=/opt/loyalty-secrets/signer-key.pem
# APPLE_WALLET_WWDR_PATH=/opt/loyalty-secrets/wwdr.pem
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_PASS_TYPE_ID=pass.com.stamposa.loyalty
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SA_KEY_PATH=/opt/loyalty-secrets/google-sa.json
