# Production environment — copy to deploy/.env.production and fill in.
#   cp deploy/env.production.example deploy/.env.production
# NEVER commit .env.production (it is gitignored).

# ── Domains (three subdomains, one per role) ───────────────────────────────
# CloudStick's nginx terminates HTTPS and reverse-proxies each domain to the
# localhost port below (see deploy/DEPLOYMENT.md):
#   stamposa.com      → web  (marketing site)
#   app.stamposa.com  → web  (merchant / staff / admin / customer portals)
#   api.stamposa.com  → api  (backend API)
# stamposa.com and app.stamposa.com are the SAME web container (host-split in
# middleware) — do not point them at different builds.
SITE_DOMAIN=stamposa.com
APP_DOMAIN=app.stamposa.com
API_DOMAIN=api.stamposa.com

# ── Localhost ports the containers publish (CloudStick proxies to these) ────
# API_PORT is used in the backend-api slot. WEB_PORT is used in a web slot —
# give the two web slots DIFFERENT ports (e.g. stamposawebsite=3000,
# frontend-app=3001) so their containers don't clash on the same server.
WEB_PORT=3000
API_PORT=4000

# ── Database (runs in a container on THIS server — your data stays here) ────
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# ── Auth secrets ───────────────────────────────────────────────────────────
# Generate EACH with: openssl rand -hex 32  (two DIFFERENT values!)
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars

# ── Admin panel ────────────────────────────────────────────────────────────
# Must stay true in production — the API refuses to boot otherwise. Admins
# enrol an authenticator app on first sign-in at https://app.stamposa.com/admin.
ADMIN_REQUIRE_2FA=true
# Initial password for the seeded admin accounts (change after first login).
SEED_ADMIN_PASSWORD=replace-me-strong

# ── Billing: Dodo Payments (Merchant of Record) ────────────────────────────
# Leave DODO_API_KEY blank to launch with checkout in "contact us" mode.
# For live payments, use LIVE credentials + LIVE product ids, and set the
# webhook in Dodo to: https://api.stamposa.com/v1/billing/webhook
# See docs/BILLING-SETUP.md.
DODO_ENVIRONMENT=live_mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_GROWTH_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=

# ── SMS (customer OTP) ─────────────────────────────────────────────────────
# 'console' prints OTPs to `docker compose logs api` — useless for real
# customers. For real SMS set msg91 + the three credentials (docs/SMS-SETUP.md).
SMS_PROVIDER=console
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=STMPSA
DEFAULT_PHONE_REGION=IN

# ── Transactional email (merchant signup + admin email codes) ──────────────
# 'console' logs codes to `docker compose logs api`. For real email set smtp
# and fill all five (Gmail: smtp.gmail.com / 587 / secure false / app password).
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Stamposa <your-address@gmail.com>

# ── Error monitoring (optional — docs/MONITORING-SETUP.md) ─────────────────
# SENTRY_DSN=
# WEB_SENTRY_DSN=

# ── Wallet passes (optional — docs/WALLET-SETUP.md) ────────────────────────
# APPLE_WALLET_CERT_PATH=/opt/stamposa-secrets/signer.pem
# APPLE_WALLET_KEY_PATH=/opt/stamposa-secrets/signer-key.pem
# APPLE_WALLET_WWDR_PATH=/opt/stamposa-secrets/wwdr.pem
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_PASS_TYPE_ID=pass.com.stamposa.loyalty
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SA_KEY_PATH=/opt/stamposa-secrets/google-sa.json
