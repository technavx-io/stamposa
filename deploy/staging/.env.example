# Stamposa STAGING .env — copy to /opt/staging/.env on the VPS.
#
# Never reuse prod secrets. Every JWT/DB/wallet identifier below should be
# distinct from /opt/api-docker/.env.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=4001

# ── Data stores (staging Postgres on 5433, staging Redis on 6380) ──────────
POSTGRES_PASSWORD=CHANGEME-staging-only-different-from-prod
DATABASE_URL=postgresql://loyalty:CHANGEME-staging-only-different-from-prod@127.0.0.1:5433/loyalty_platform?schema=public
REDIS_URL=redis://127.0.0.1:6380

# ── Auth (MUST be different from prod) ─────────────────────────────────────
# openssl rand -hex 32   (twice, two different values)
JWT_ACCESS_SECRET=REPLACE-64-hex-chars-staging-only
JWT_REFRESH_SECRET=REPLACE-64-hex-chars-staging-only
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# ── URLs / CORS (staging subdomains) ───────────────────────────────────────
WEB_APP_URL=https://app-staging.stamposa.com
API_PUBLIC_URL=https://api-staging.stamposa.com
CORS_ORIGINS=https://staging.stamposa.com,https://app-staging.stamposa.com

# ── Files ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── SMS / OTP — console in staging so no real SMS costs ────────────────────
SMS_PROVIDER=console
OTP_DEV_EXPOSE=true
DEFAULT_PHONE_REGION=IN

# ── Email — console in staging so no real emails to real people ────────────
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Stamposa Staging <no-reply@stamposa.com>

# Staging alerts (cert-expiry runs here too, though staging LE certs are
# short-lived and covered by CloudStick's own renewal). Leave empty to
# silence, or set to a personal address if you want to test the alert path.
ALERT_EMAIL=

# ── Admin ──────────────────────────────────────────────────────────────────
# 2FA can be off in staging so you can log in without an authenticator app.
# Fine because staging admins can't touch prod data (different DB, different
# JWT secrets). The env schema still forces it on when NODE_ENV=production.
ADMIN_REQUIRE_2FA=false

# ── Sentry — separate project (or dsn) to keep staging noise out of prod ───
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Wallet certs — pass type ID MUST differ from prod ──────────────────────
# Otherwise a staging pass installed on your phone overwrites the prod one.
APPLE_WALLET_CERT_PATH=/app/secrets/apple-wallet-cert.pem
APPLE_WALLET_KEY_PATH=/app/secrets/apple-wallet-key.pem
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PATH=/app/secrets/apple-wwdr.pem
APPLE_WALLET_TEAM_ID=
# Different from prod — e.g. pass.com.stamposa.loyalty.staging
APPLE_WALLET_PASS_TYPE_ID=pass.com.stamposa.loyalty.staging
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY_PATH=/app/secrets/google-wallet-sa.json

# ── Billing — always test_mode in staging ──────────────────────────────────
DODO_ENVIRONMENT=test_mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_GROWTH_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=

# ── Backups — staging is disposable, no backups needed ─────────────────────
# R2 vars intentionally omitted here. Data is refreshed from prod via
# refresh-from-prod.sh on demand.
