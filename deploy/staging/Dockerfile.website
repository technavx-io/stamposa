# staging.stamposa.com — prebuilt Next.js standalone bundle of apps/website,
# rebuilt with staging NEXT_PUBLIC_* URLs baked in.
#
# Identical to website-docker/Dockerfile.website except this image is the
# staging tag and the compose sets PORT=3010.
FROM node:22-alpine
# Default bind is loopback — compose overrides identically. Fails safe if
# ever run outside compose.
ENV NODE_ENV=production PORT=3010 HOSTNAME=127.0.0.1
WORKDIR /app
COPY website/ ./
EXPOSE 3010
CMD ["node", "apps/website/server.js"]
