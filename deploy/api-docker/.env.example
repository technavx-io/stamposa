# Stamposa API — production .env template.
#
# Copy to /opt/api-docker/.env on the VPS and fill in real values. This file
# is loaded first by docker-compose.yml; build-info.env is loaded after it and
# is written by build-bundles.sh (do not put version stamps here).
#
# Never commit the real .env. Never paste it anywhere.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Data stores (compose supplies POSTGRES_PASSWORD to the postgres image) ─
POSTGRES_PASSWORD=CHANGEME-strong-random-value
# The API talks to the postgres container over the host network (127.0.0.1).
DATABASE_URL=postgresql://loyalty:CHANGEME-strong-random-value@127.0.0.1:5432/loyalty_platform?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32   (use two DIFFERENT values)
JWT_ACCESS_SECRET=REPLACE-64-hex-chars
JWT_REFRESH_SECRET=REPLACE-64-hex-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# ── URLs / CORS ────────────────────────────────────────────────────────────
WEB_APP_URL=https://app.stamposa.com
API_PUBLIC_URL=https://api.stamposa.com
CORS_ORIGINS=https://stamposa.com,https://app.stamposa.com

# ── Files ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── SMS (MSG91 / India DLT) ────────────────────────────────────────────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=STMPSA
OTP_DEV_EXPOSE=false
DEFAULT_PHONE_REGION=IN

# ── Transactional + alert email (SMTP) ─────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Stamposa <no-reply@stamposa.com>

# Address that receives cert-expiry warnings and backup-failure alerts.
# Set in production — a silent expiry or a broken backup is an outage.
ALERT_EMAIL=

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_REQUIRE_2FA=true

# ── Error monitoring (Sentry) ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Wallet certs (Apple + Google) ──────────────────────────────────────────
# Files live under /opt/stamposa-secrets on the host, mounted read-only at
# /app/secrets in the api container.
APPLE_WALLET_CERT_PATH=/app/secrets/apple-wallet-cert.pem
APPLE_WALLET_KEY_PATH=/app/secrets/apple-wallet-key.pem
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PATH=/app/secrets/apple-wwdr.pem
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=pass.com.stamposa.loyalty
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY_PATH=/app/secrets/google-wallet-sa.json

# ── Billing: Dodo Payments ─────────────────────────────────────────────────
DODO_ENVIRONMENT=live_mode
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_GROWTH_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=

# ── Backups (Cloudflare R2) ────────────────────────────────────────────────
# The backup sidecar (see api-docker/backup/) reads these. Bucket must exist
# with lifecycle rules on daily/, weekly/, monthly/ prefixes.
# Passphrase encrypts the dump BEFORE it leaves the box — losing it means
# losing the backups. Store a copy in your password manager AND offline.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stamposa-backups
BACKUP_ENCRYPTION_PASSPHRASE=
